{
  "name": "react-example",
  "private": true,
  "version": "5.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "vite build && electron .",
    "mobile:build": "vite build && node scripts/build-mobile.cjs && npx cap sync android",
    "pack": "vite build && electron-builder --dir",
    "build:exe": "node scripts/prune-onnx.cjs win32 && vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.clipforge.desktop",
    "productName": "ClipForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icons/icon.png"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icons/icon.ico"
    },
    "portable": {
      "artifactName": "ClipForge-windows-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "binaries",
        "to": "binaries"
      },
      {
        "from": "public/fonts",
        "to": "fonts"
      },
      {
        "from": "assets/emoji",
        "to": "emoji"
      },
      {
        "from": "assets/sfx",
        "to": "sfx"
      },
      {
        "from": "assets/icons/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "electron/engine/facetrack/**",
      "node_modules/onnxruntime-node/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "icon": "assets/icons/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "artifactName": "${productName}-linux-${arch}.${ext}",
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipForge",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ClipForge-Setup-windows-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/toast": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "capacitor-nodejs": "https://github.com/hampoelz/capacitor-nodejs/releases/download/v1.0.0-beta.10/capacitor-nodejs.tgz",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "clipforge": {
    "updateRepo": "tahaonerwp2010/ClipForge"
  },
  "author": {
    "name": "ClipForge",
    "email": "clipforge@users.noreply.github.com"
  },
  "description": "ClipForge Studio - AI video clipper",
  "repository": {
    "type": "git",
    "url": "https://github.com/tahaonerwp2010/ClipForge.git"
  },
  "homepage": "https://github.com/tahaonerwp2010/ClipForge"
}
