{
  "name": "react-example",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "vite build && electron .",
    "pack": "vite build && electron-builder --dir",
    "build:exe": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.clipforge.desktop",
    "productName": "ClipForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": "portable",
      "artifactName": "${productName}-windows-${arch}.${ext}",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ]
    },
    "portable": {
      "artifactName": "${productName}-windows-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "binaries",
        "to": "binaries"
      },
      {
        "from": "public/fonts",
        "to": "fonts"
      },
      {
        "from": "assets/emoji",
        "to": "emoji"
      }
    ],
    "asarUnpack": [
      "electron/engine/facetrack/**",
      "node_modules/onnxruntime-node/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "icon": "build/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "artifactName": "${productName}-linux-${arch}.${ext}",
      "icon": "build/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "clipforge": {
    "updateRepo": "tahaonerwp2010/ClipForge"
  },
  "author": "ClipForge",
  "description": "ClipForge Studio - AI video clipper"
}
