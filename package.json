{
  "name": "react-example",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "vite build && electron .",
    "pack": "vite build && electron-builder --dir",
    "build:exe": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.clipforge.desktop",
    "productName": "ClipForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": "portable",
      "artifactName": "${productName}-windows-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-windows-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "binaries",
        "to": "binaries"
      },
      {
        "from": "public/fonts",
        "to": "fonts"
      },
      {
        "from": "assets/emoji",
        "to": "emoji"
      }
    ],
    "asarUnpack": [
      "electron/engine/facetrack/**"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "clipforge": {
    "updateRepo": "tahaonerwp2010/ClipForge"
  }
}